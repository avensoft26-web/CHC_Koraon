# Chaudhary Hospital Management System - Frontend Environment Configuration Template
# COPY this file to .env.local if you are hosting frontend separately from backend.

# Base API URL (Leave blank or '/api' when backend and frontend are hosted together)
# Example for split hosting: https://api.yourhospitaldomain.com/api
VITE_API_BASE_URL=/api

# Firebase Web Client Configuration (Optional for client-side push notification registration)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_VAPID_KEY=your_vapid_key
